{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spaceobject-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "vars": {
    "ERC_8004_SUBGRAPH_URL": "https://api.studio.thegraph.com/query/1723243/erc-8004-arc-testnet/version/latest",
    "ERC_8183_SUBGRAPH_URL": "https://api.studio.thegraph.com/query/1723243/space-object-erc-8183-agentic-commerce/version/latest",
  },
}
