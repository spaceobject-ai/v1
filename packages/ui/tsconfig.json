{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["DOM", "ES2023"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "declaration": true,
    "noEmit": true
  }
}
