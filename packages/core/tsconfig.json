{
  "include": ["src/**/*.ts", "vite.config.ts"],
  "compilerOptions": {
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "declaration": true,
    "noEmit": true
  }
}
